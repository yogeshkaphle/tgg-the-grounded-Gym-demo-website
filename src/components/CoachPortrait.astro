---
// Coach photo slot. Cropped or back shots only: the coaches are fictional, so a
// face would present a real person as someone they are not. Labelled "Sample coach"
// on the demo. Add photos as src/assets/photos/coach-1.jpg, coach-2.jpg ...
import PhotoSlot from './PhotoSlot.astro';
import type { Coach } from '../data/coaches.ts';
import { site } from '../data/site.ts';

interface Props {
  coach: Coach;
  sizes?: string;
  small?: boolean;
}
const { coach, sizes = '(min-width: 900px) 360px, 92vw', small = false } = Astro.props;
---

<PhotoSlot
  name={coach.photo}
  alt={`Sample coach ${coach.firstName}, ${coach.role.toLowerCase()}, photographed from behind`}
  sizes={sizes}
  compact={small}
  class={small ? 'portrait portrait--sm' : 'portrait'}
  label={site.demo.enabled && !small ? 'Sample coach' : undefined}
/>

<style>
  :global(.portrait--sm) {
    aspect-ratio: 1 / 1 !important;
  }
</style>
