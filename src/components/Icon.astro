---
// Small inline icon set. Stroke icons inherit currentColor.
interface Props {
  name:
    | 'arrow'
    | 'arrow-left'
    | 'phone'
    | 'whatsapp'
    | 'viber'
    | 'pin'
    | 'clock'
    | 'check'
    | 'menu'
    | 'close'
    | 'plus'
    | 'alert'
    | 'info'
    | 'map'
    | 'share'
    | 'print'
    | 'instagram'
    | 'facebook'
    | 'calendar'
    | 'bag'
    | 'spark'
    | 'parking';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: className, label } = Astro.props;
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...a11y}
>
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 18l-6-6 6-6" />}
  {
    name === 'phone' && (
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
    )
  }
  {
    name === 'whatsapp' && (
      <>
        <path d="M3.5 20.5l1.3-4.6A8.5 8.5 0 1 1 8 19.3z" />
        <path
          d="M9 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.4.7 1 1.3 1.7 1.8.3.2.6.3.8.4.2.1.4 0 .5-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .5-.1 1.1-.6 1.4-.5.4-1.2.6-1.9.4-1.2-.3-2.3-.9-3.2-1.8-.9-.8-1.7-1.8-2.1-2.9-.3-.8-.2-1.6.2-2z"
          fill="currentColor"
          stroke="none"
        />
      </>
    )
  }
  {
    name === 'viber' && (
      <>
        <path d="M12 2.5c5 0 8.5 2.2 8.5 8s-3.5 8-8.5 8c-.8 0-1.6-.1-2.3-.2L6.5 21v-3.4C4.3 16.3 3.5 14 3.5 10.5c0-5.8 3.5-8 8.5-8z" />
        <path d="M12.5 6.5a4 4 0 0 1 4 4M12.5 8.8a1.8 1.8 0 0 1 1.7 1.7" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
        <circle cx="12" cy="10" r="3" />
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </>
    )
  }
  {name === 'check' && <path d="M4 12.5l5 5L20 6.5" stroke-width="2.5" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {
    name === 'alert' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7.5v5.5M12 16.5v.01" stroke-width="2.5" />
      </>
    )
  }
  {
    name === 'info' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5.5M12 7.5v.01" stroke-width="2.5" />
      </>
    )
  }
  {
    name === 'map' && (
      <>
        <path d="M9 4 3 6.5v13.5l6-2.5 6 2.5 6-2.5V4l-6 2.5z" />
        <path d="M9 4v13.5M15 6.5V20" />
      </>
    )
  }
  {
    name === 'share' && (
      <>
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
      </>
    )
  }
  {
    name === 'print' && (
      <>
        <path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
        <path d="M6 14h12v8H6z" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <path d="M17.5 6.5v.01" stroke-width="2.5" />
      </>
    )
  }
  {name === 'facebook' && <path d="M15 3h-2.5A4.5 4.5 0 0 0 8 7.5V10H5.5v3.5H8V21h3.5v-7.5H14l.5-3.5h-3V7.8c0-.8.4-1.3 1.3-1.3H15z" />}
  {
    name === 'calendar' && (
      <>
        <rect x="3" y="4.5" width="18" height="16.5" rx="2.5" />
        <path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
      </>
    )
  }
  {
    name === 'bag' && (
      <>
        <path d="M5 8h14l-1 12.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 20.5z" />
        <path d="M9 8V6a3 3 0 0 1 6 0v2" />
      </>
    )
  }
  {
    name === 'parking' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M9.5 17V7h3.5a3 3 0 0 1 0 6H9.5" />
      </>
    )
  }
  {name === 'spark' && <path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8" />}
</svg>
