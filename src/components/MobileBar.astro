---
// Phones only: the three ways to act, always in thumb reach.
// The header has no trial button on phones, so there is one offer button on screen, not two.
import ContactLink from './ContactLink.astro';
import { site } from '../data/site.ts';
---

<nav class="mobile-bar no-print" aria-label="Quick actions">
  <ContactLink channel="call" class="mobile-bar__btn" location="mobile_bar">Call</ContactLink>
  <ContactLink channel="whatsapp" class="mobile-bar__btn" location="mobile_bar">WhatsApp</ContactLink>
  <a class="btn btn--primary mobile-bar__cta" href="/trial" data-track="trial_cta_click" data-track-location="mobile_bar">
    {site.offer}
  </a>
</nav>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1fr 1.9fr;
    gap: 8px;
    padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
    background: rgb(242 244 245 / 0.96);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 960px) {
    .mobile-bar {
      display: none;
    }
  }
  .mobile-bar :global(.mobile-bar__btn) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 52px;
    border-radius: 12px;
    border: 1.5px solid var(--line-strong);
    background: var(--card);
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--slate);
  }
  .mobile-bar__cta {
    min-height: 52px;
    padding-inline: 0.5rem;
    font-size: 1.2rem; /* 19.2px bold: large text, so white on orange (3.7:1) passes */
  }
</style>
