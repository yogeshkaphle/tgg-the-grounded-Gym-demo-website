---
// Slim bar above every page. Honest about the demo before anyone types a phone
// number, and the switch that turns on the conversion notes for gym owners.
import { site } from '../data/site.ts';
---

<div class="demo-strip no-print">
  <p class="demo-strip__text">
    <span class="demo-strip__long">Demo site by <a href={site.demo.authorUrl}>{site.demo.author}</a>. Grounded Gym is not a real gym.</span>
    <span class="demo-strip__short">Demo by <a href={site.demo.authorUrl}>{site.demo.author}</a></span>
  </p>
  <button
    type="button"
    class="demo-strip__toggle"
    data-notes-toggle
    data-label-off="See how it converts"
    data-label-on="Hide the notes"
    aria-pressed="false"
  >
    <span class="demo-strip__dot" aria-hidden="true"></span>
    <span data-notes-label>See how it converts</span>
  </button>
</div>

<style>
  .demo-strip {
    background: var(--ink);
    color: var(--on-dark-muted);
    font-size: 0.8125rem;
    line-height: 1.3;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    padding: 0.35rem var(--gutter);
    min-height: 40px;
  }
  .demo-strip a {
    color: var(--on-dark);
    font-weight: 650;
  }
  .demo-strip__short {
    display: none;
  }
  @media (max-width: 560px) {
    .demo-strip {
      justify-content: space-between;
    }
    .demo-strip__long {
      display: none;
    }
    .demo-strip__short {
      display: inline;
    }
  }
  .demo-strip__toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 34px;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgb(244 239 230 / 0.35);
    background: transparent;
    color: var(--on-dark);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  /* 44px tap area without a taller strip */
  .demo-strip__toggle::after {
    content: '';
    position: absolute;
    inset: -5px -2px;
  }
  .demo-strip__toggle:hover {
    border-color: var(--on-dark);
  }
  .demo-strip__toggle[aria-pressed='true'] {
    background: var(--brick-on-dark);
    border-color: var(--brick-on-dark);
    color: var(--ink);
  }
  .demo-strip__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brick-on-dark);
  }
  .demo-strip__toggle[aria-pressed='true'] .demo-strip__dot {
    background: var(--ink);
  }
</style>
