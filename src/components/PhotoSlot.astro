---
// A photo slot. When src/assets/photos/<name>.(jpg|jpeg|png|webp|avif) exists it is
// resized and served as AVIF/WebP; until then a plain, labelled placeholder holds
// the space at the same size, so adding a photo never moves the layout.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photoSlots, type PhotoSlotName } from '../data/photos.ts';

interface Props {
  name: PhotoSlotName;
  sizes: string;
  class?: string;
  priority?: boolean; // the hero: load first, no lazy loading
  label?: string; // small overlay label, e.g. "Sample coach"
  compact?: boolean; // tiny slots (avatars): icon only, no placeholder text
}
const { name, sizes, class: className, priority = false, label, compact = false } = Astro.props;
const slot = photoSlots[name];
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const match = Object.entries(files).find(([file]) => file.split('/').pop()?.replace(/\.[a-z]+$/, '') === name);
---

<figure class:list={['photo', className]} style={`--ratio: ${slot.ratio}`}>
  {
    match ? (
      <Picture
        src={match[1].default}
        alt={slot.alt}
        formats={['avif', 'webp']}
        widths={[...slot.widths]}
        sizes={sizes}
        quality={62}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <div class="photo__empty" role="img" aria-label={`Photo to come: ${slot.alt}`}>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 8h3l2-2.5h6L17 8h3v11H4z" />
          <circle cx="12" cy="13" r="3.5" />
        </svg>
        {!compact && <span>{slot.placeholder}</span>}
      </div>
    )
  }
  {label && <span class="photo__label">{label}</span>}
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--snow-3);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo__empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: 1.5rem;
    text-align: center;
    color: var(--stone-ink);
    font-size: 0.9rem;
    line-height: 1.4;
    background: repeating-linear-gradient(135deg, transparent 0 18px, rgb(138 143 148 / 0.16) 18px 19px), var(--snow-3);
  }
  .photo__empty span {
    max-width: 26ch;
  }
  .photo__label {
    position: absolute;
    left: 10px;
    top: 10px;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    background: var(--slate);
    color: var(--on-slate);
    font-size: 0.8125rem;
    font-weight: 700;
  }
</style>
