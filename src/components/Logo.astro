---
// Mark: a squared G on a ground line. Slate on light backgrounds, snow on dark;
// the ground bar is always prayer-flag orange.
interface Props {
  href?: string | null;
  tone?: 'slate' | 'snow';
  size?: 'md' | 'lg';
}
const { href = '/', tone = 'slate', size = 'md' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['logo', `logo--${tone}`, `logo--${size}`]} href={href ?? undefined} aria-label={href ? 'Grounded Gym, home' : undefined}>
  <svg class="logo__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path d="M52 12.5 L12.5 12.5 L12.5 42.5 L47.5 42.5 L47.5 28 L32 28" fill="none" stroke="currentColor" stroke-width="9" stroke-linejoin="miter"></path>
    <rect x="4" y="50" width="56" height="7" fill="#E4572E"></rect>
  </svg>
  <span class="logo__word"><span>Grounded</span> <span class="logo__gym">Gym</span></span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--slate);
    line-height: 1;
    min-height: 44px;
  }
  .logo--snow {
    color: var(--on-slate);
  }
  .logo__mark {
    width: 36px;
    height: 36px;
    flex: none;
  }
  .logo__word {
    font-weight: 850;
    font-family: var(--font-display);
    font-size: 1.65rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .logo__gym {
    color: var(--flag);
  }
  .logo--snow .logo__gym {
    color: var(--flag-on-slate);
  }
  .logo--lg .logo__mark {
    width: 44px;
    height: 44px;
  }
  .logo--lg .logo__word {
    font-size: 2rem;
  }
</style>
