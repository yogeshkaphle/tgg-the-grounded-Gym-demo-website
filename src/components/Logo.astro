---
// Mark: a kettlebell standing on the ground line. Grounded, and obviously a gym.
interface Props {
  href?: string | null;
  tone?: 'slate' | 'snow';
  size?: 'md' | 'lg';
}
const { href = '/', tone = 'slate', size = 'md' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['logo', `logo--${tone}`, `logo--${size}`]} href={href ?? undefined} aria-label={href ? 'Grounded Gym, home' : undefined}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <path d="M11.4 22C9.4 15 11.8 8.6 20 8.6S30.6 15 28.6 22" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"></path>
    <path d="M14.4 33.6A10 10 0 1 1 25.6 33.6Z" fill="currentColor"></path>
    <rect x="2" y="35.4" width="36" height="2.6" rx="1.3" class="logo__ground"></rect>
  </svg>
  <span class="logo__word"><span>Grounded</span> <span class="logo__gym">Gym</span></span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--slate);
    line-height: 1;
    min-height: 44px;
  }
  .logo--snow {
    color: var(--on-slate);
  }
  .logo__mark {
    width: 34px;
    height: 34px;
    flex: none;
  }
  .logo__ground {
    fill: var(--flag);
  }
  .logo--snow .logo__ground {
    fill: var(--flag-on-slate);
  }
  .logo__word {
    font-weight: 850;
    font-family: var(--font-display);
    font-size: 1.65rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .logo__gym {
    color: var(--flag);
  }
  .logo--snow .logo__gym {
    color: var(--flag-on-slate);
  }
  .logo--lg .logo__mark {
    width: 44px;
    height: 44px;
  }
  .logo--lg .logo__word {
    font-size: 2rem;
  }
</style>
