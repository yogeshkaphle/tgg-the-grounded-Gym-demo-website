---
// A "why this is here" note for gym owners reviewing the demo.
// Hidden until the visitor turns on "Show how this site converts".
import { site } from '../data/site.ts';
interface Props {
  label?: string;
}
const { label = 'Why this is here' } = Astro.props;
---

{
  site.demo.enabled && (
    <aside class="demo-note" aria-label="Demo note">
      <p class="demo-note__label">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 11v5.5M12 7.5v.01" />
        </svg>
        {label}
      </p>
      <slot />
    </aside>
  )
}
