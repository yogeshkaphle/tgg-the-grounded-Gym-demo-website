---
// Swipeable on phones (the next card peeks in), three across on desktop.
// Every card carries the sample label. No faces.
import { results, SAMPLE_LABEL, type Result } from '../data/results.ts';

interface Props {
  ids?: string[];
  single?: boolean;
}
const { ids, single = false } = Astro.props;
const list: Result[] = ids ? results.filter((r) => ids.includes(r.id)) : results;
---

<ul role="list" class:list={['results', { 'results--single': single }]} aria-label="Sample member results">
  {
    list.map((r) => (
      <li class="result">
        <p class="result__label">{SAMPLE_LABEL}</p>
        <p class="result__stat">{r.stat}</p>
        <p class="result__stat-label">{r.statLabel}</p>
        <blockquote class="result__quote">
          <p>{r.quote}</p>
        </blockquote>
        <p class="result__who">
          {r.who} · {r.weeks} weeks
        </p>
      </li>
    ))
  }
</ul>

<style>
  .results {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84%, 360px);
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px var(--gutter) 18px;
    margin-inline: calc(var(--gutter) * -1);
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }
  @media (min-width: 900px) {
    .results {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      grid-auto-columns: auto;
      overflow: visible;
      padding: 0;
      margin: 0;
    }
  }
  .results--single {
    display: block;
    overflow: visible;
    padding: 0;
    margin: 0;
  }
  .result {
    scroll-snap-align: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 22px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    position: relative;
    overflow: hidden;
  }
  :global(.section--dark) .result {
    background: var(--slate-raised);
    border-color: rgb(242 244 245 / 0.12);
  }
  .result__label {
    align-self: flex-start;
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px dashed currentColor;
    color: var(--flag-ink);
    margin-bottom: 0.6rem;
  }
  :global(.section--dark) .result__label {
    color: var(--flag-on-slate);
  }
  .result__stat {
    font-size: clamp(2.4rem, 2rem + 2vw, 3.2rem);
    font-weight: 850;
    font-family: var(--font-display);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .result__stat-label {
    font-weight: 700;
    color: var(--stone-ink);
  }
  :global(.section--dark) .result__stat-label {
    color: var(--on-slate-muted);
  }
  .result__quote {
    margin-top: 0.8rem;
    font-size: 1.02rem;
    line-height: 1.5;
    flex: 1;
  }
  .result__quote p::before {
    content: '\201C';
  }
  .result__quote p::after {
    content: '\201D';
  }
  .result__who {
    margin-top: 0.8rem;
    font-size: 0.9rem;
    font-weight: 700;
  }
</style>
