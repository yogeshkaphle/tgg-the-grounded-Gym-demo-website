---
// Hero visual: the offer drawn as a pass. Sells the Free Trial Week without a stock photo.
import { site } from '../data/site.ts';
import { days } from '../data/timetable.ts';
---

<div class="ticket" aria-hidden="true">
  <div class="ticket__top">
    <span class="ticket__kicker">Admit one</span>
    <span class="ticket__kicker">7 days</span>
  </div>
  <p class="ticket__title">Free<br />Trial<br />Week</p>
  <div class="ticket__perf"></div>
  <ol class="ticket__days" role="list">
    {days.map((d) => <li>{d.short}</li>)}
  </ol>
  <p class="ticket__line">Any class · no fee · then you decide</p>
  <p class="ticket__foot">
    <span>{site.name}</span>
    <span>{site.area}</span>
  </p>
</div>

<style>
  .ticket {
    position: relative;
    width: min(100%, 380px);
    padding: 26px 26px 22px;
    border-radius: 24px;
    background: var(--ink);
    color: var(--on-dark);
    box-shadow:
      0 30px 60px -30px rgb(29 27 24 / 0.55),
      0 2px 0 rgb(0 0 0 / 0.2);
    transform: rotate(-3deg);
    isolation: isolate;
    overflow: hidden;
  }
  .ticket::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--brick-on-dark);
    opacity: 0.2;
    -webkit-mask: url('/contours.svg') center / cover no-repeat;
    mask: url('/contours.svg') center / cover no-repeat;
  }
  .ticket__top {
    display: flex;
    justify-content: space-between;
  }
  .ticket__kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brick-on-dark);
  }
  .ticket__title {
    margin-top: 18px;
    font-size: clamp(2.6rem, 2rem + 2.4vw, 3.6rem);
    font-weight: 850;
    font-stretch: 125%;
    line-height: 0.92;
    letter-spacing: -0.035em;
  }
  .ticket__perf {
    margin: 22px -26px 18px;
    border-top: 2px dashed rgb(244 239 230 / 0.35);
    position: relative;
  }
  .ticket__perf::before,
  .ticket__perf::after {
    content: '';
    position: absolute;
    top: -13px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--paper);
  }
  .ticket__perf::before {
    left: -12px;
  }
  .ticket__perf::after {
    right: -12px;
  }
  .ticket__days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
  }
  .ticket__days li {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 10px;
    background: rgb(244 239 230 / 0.1);
    font-size: 0.72rem;
    font-weight: 750;
  }
  .ticket__days li:first-child {
    background: var(--brick);
  }
  .ticket__line {
    margin-top: 16px;
    font-weight: 650;
    color: var(--on-dark-muted);
    font-size: 0.95rem;
  }
  .ticket__foot {
    margin-top: 14px;
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
