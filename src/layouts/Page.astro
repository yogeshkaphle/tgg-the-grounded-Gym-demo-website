---
// Standard page: header, content, footer, and the phone action bar.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NotesOwnerCta from '../components/NotesOwnerCta.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | null;
}
const props = Astro.props;
---

<Base {...props}>
  <slot name="head" slot="head" />
  <Header />
  <main id="main">
    <slot />
  </main>
  <NotesOwnerCta />
  <Footer />
  <MobileBar />
</Base>
