---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.ts';

const links = [
  { href: '/timetable', label: 'This week’s timetable' },
  { href: '/membership', label: 'Membership and prices' },
  { href: '/train-anywhere', label: 'Free Train Anywhere sessions' },
];
---

<Page title="Page not found" description="This page doesn't exist.">
  <section class="section nf">
    <div class="wrap nf__inner">
      <h1 class="h1">This page took a wrong turn at Tinkune.</h1>
      <p class="lede">The link may be old, or mistyped. Here are the pages people usually want.</p>
      <ul role="list" class="nf__links">
        {
          links.map((l) => (
            <li>
              <a class="arrow-link" href={l.href}>
                {l.label} <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary" href="/trial" data-track="trial_cta_click" data-track-location="404">
        Book {site.offer}
      </a>
    </div>
  </section>
</Page>

<style>
  .nf {
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .nf__inner {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .nf__links {
    display: grid;
    gap: 0.2rem;
  }
</style>
